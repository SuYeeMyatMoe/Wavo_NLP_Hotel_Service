# For a local walkthrough without accounts use preview. Use connected for real guests.
HOTEL_MODE=preview
# Enable only for the demo hotel; autofills public demo accounts using real Supabase Auth.
WAVO_DEMO_LOGIN=false
# live uses Gemini for staff reports; test uses the explicitly labeled local parser.
# Both modes enforce real backend permissions and persist to the configured database.
WORK_ASSISTANT_MODE=live
# auto uses Gemini Live when configured. local uses Whisper and approved replies.
CONCIERGE_MODE=auto
# Leave empty to use the embedded FastAPI app locally.
HOTEL_API_URL=
# Optional for hosted sign-in and storage. Open https://supabase.com/dashboard
# Select your project > Connect for the project URL.
SUPABASE_URL=
# Project Settings > API Keys > Publishable key.
SUPABASE_PUBLISHABLE_KEY=
# Backend and worker only. TLS session-pooler or direct PostgreSQL connection.
# In Connect > Connection string, copy the Session pooler URI and set its password.
DATABASE_URL=
# Persistent PostgreSQL connections per API/operations process.
WAVO_DB_POOL_MAX=4
# Browser -> FastAPI call startup. Use your HTTPS API URL when hosted.
WAVO_BROWSER_API_URL=http://127.0.0.1:8000
# Explicit Streamlit origins only; comma-separated, never a wildcard.
WAVO_BROWSER_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# For browser calls: https://cloud.livekit.io/ > your project > Settings > Keys
# Use the wss:// project URL plus the API key and secret from the same project.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Generate a Gemini key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Warm call workers. Keep 1 for the local app; scale on a dedicated host.
WAVO_VOICE_IDLE_WORKERS=1
# Local laptop: admit calls by available call slots, not unrelated CPU spikes.
# Set admission=cpu on a dedicated production host for SDK CPU admission.
WAVO_VOICE_ADMISSION=calls
WAVO_VOICE_MAX_CALLS=2
# Restart Streamlit and the API after editing .env. Start the worker separately:
# .\.venv\Scripts\python.exe -m pip install -r hotel/voice-requirements.txt
# .\.venv\Scripts\python.exe -m hotel.voice_worker dev
# Voice messages use local models. To download them on a fresh install:
# .\.venv\Scripts\python.exe -m hotel.language_models


# Backend only: Supabase secret/service-role key for private Realtime Broadcast.
# Never put this key in Streamlit component data or browser code.
SUPABASE_SECRET_KEY=
# Persistent monitoring/outbox worker: python -m hotel.operations_worker
# LiveKit worker requires HOTEL_API_URL pointing to the separately running API.
