FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /app
COPY deploy/requirements-api.txt deploy/requirements-web.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-api.txt -r /tmp/requirements-web.txt pytest psutil
COPY app.py /app/
COPY hotel /app/hotel
COPY artifacts /app/artifacts
COPY research/urgency.py /app/research/urgency.py
COPY research/train.py research/partition.csv research/safety_reviews.csv /app/research/
COPY static /app/static
COPY .streamlit/config.toml /app/.streamlit/config.toml
COPY tests /app/tests
COPY data /app/data
ENV HOTEL_MODE=preview WAVO_LANGUAGE_PROVIDER=gemini PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
CMD ["python", "-m", "pytest", "-q", "tests"]
